# Server environment
NODE_ENV=development
PORT=4000

# Database (MySQL/MariaDB)
DB_HOST=127.0.0.1
DB_USER=mining_user
DB_PASS=mining_pass
DB_NAME=mining_app

# Optional: local fallback without MySQL
# DB_CLIENT=sqlite3

# Auth/session
JWT_SECRET=change-me-in-production
COOKIE_NAME=admin_session
COOKIE_MAX_AGE_MS=2592000000

# SMTP (for OTP email verifications + password resets)
# Recommended for cPanel: enable SMTP over STARTTLS (587)
SMTP_HOST=smtp.zatn.in
SMTP_PORT=465
SMTP_USER=admin@zatn.in
SMTP_PASS=ZatnAdmin@123
SMTP_FROM_EMAIL=admin@zatn.in
SMTP_FROM_NAME=AppGeo Admin

# Uploads
UPLOAD_ROOT=../mining-website/public/uploads

